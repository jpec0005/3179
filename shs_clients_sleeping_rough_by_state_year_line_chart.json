{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Rough Sleepers per Year by State/Territory"
  },
  "width": 283,
  "height": 271,
  "data": {
    "url": "shs_clients_sleeping_rough_by_state_year.csv"
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": false,
      "fill": "white"
    },
    "tooltip": true
  },
  "encoding": {
    "y": {
      "field": "number",
      "type": "quantitative",
      "title": "Number"
    },
    "x": {
      "timeUnit": "year",
      "field": "year",
      "type": "temporal",
      "title": "Year",
      "axis": {
        "labelAngle": -90
      }
    },
    "color": {
      "field": "state_territory",
      "type": "nominal",
      "title": "State/Territory",
      "legend":{"orient":"bottom", "columns": 4}
      
    }
  }
}