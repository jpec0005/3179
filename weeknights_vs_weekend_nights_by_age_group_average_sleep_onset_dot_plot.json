{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": { "text": "Average Waking Time between Night Type by Age Group" },
  "width":200,
  "height":255,
  "data": {
    "url": "weeknights_vs_weekend_nights_by_age_group_average_sleep_onset.csv"
  }, "transform": [
    {
      "fold": ["weeknights_waking", "weekend_nights_waking"],
      "as": ["night_type", "time"]
    }
  ],
  "mark": {
  "type": "point",
  "tooltip":true
},
  "encoding": {
    "y": {
      "field": "age_group",
      "type": "nominal",
      "title": "Age group",
      "axis":{"labelAngle": 0}
    },
    
    "x": { "field": "time", "type": "quantitative", "title": "Time", "scale": {
       "domain": [6,9]
      },
      "axis": {
        "values": [6, 6.5, 7, 7.5, 8, 8.5, 9],
        "labelExpr": "datum.value === 6 ? '6:00 AM' : datum.value === 6.5 ? '6:30 AM' : datum.value === 7 ? '7:00 AM' : datum.value === 7.5 ? '7:30 AM' : datum.value === 8 ? '8:00 AM' : datum.value === 8.5 ? '8:30 AM' : '9:00 AM'",
        "labelAngle": -90
    }},
    "xOffset": {
      "field": "night_type"
    },
    "color": {
      "field": "night_type",
      "type": "nominal",
      "title": "Night Type",
      "legend": { "labelExpr": "datum.value == 'weekend_nights_waking' ? 'Weekend nights' : datum.value == 'weeknights_waking' ? 'Weeknights' : 'Other'", "orient": "bottom"}
      
    },
    "tooltip": [
    {"field": "time", "type": "nominal", "title": "Time"},
    {"field": "age_group", "type": "nominal", "title": "Age Group"}
  ]
  }
}