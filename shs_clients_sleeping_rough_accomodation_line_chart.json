{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Rough Sleepers per Year by Accommodation Type"
  },
  "width": 300,
  "height": 250,
  "data": {
    "url": "accommodation_by_rough_sleeper_nationally.csv"
  },
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "encoding": {
    "y": {
      "field": "number",
      "type": "quantitative",
      "title": "Number"
    },
    "x": {
      "timeUnit": "year",
      "field": "year",
      "type": "nominal",
      "title": "Year",
      "axis": {
        "labelAngle": -90
      }
    },
    "color": {
      "field": "type_of_accommodation",
      "type": "nominal",
      "sort": [
        "Long-term housing",
        "Medium-term/transitional housing",
        "Short-term or emergency",
        "Any accommodation provision"
      ],
      "title": "Type of Accommodation"
    },
    "order": {
      "aggregate": "sum",
      "field": "number",
      "type": "quantitative",
      "sort": "descending"
    },
    "tooltip": [
      {
        "field": "year",
        "type": "temporal",
        "format": "%Y",
        "title": "Year"
      },
      {
        "field": "number",
        "type": "quantitative",
        "title": "Number"
      },
      {
        "field": "type_of_accommodation",
        "type": "nominal",
        "title": "Type of Accommodation"
      }
    ]
  }
}