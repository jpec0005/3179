{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average Onset Time between Night Type by Age Group"
  },
  "width": 200,
  "height": 250,
  "data": {
    "url": "weeknights_vs_weekend_nights_by_age_group_average_sleep_onset.csv"
  },
  "transform": [
    {
      "fold": [
        "weeknights_onset",
        "weekend_nights_onset"
      ],
      "as": [
        "night_type",
        "time"
      ]
    }
  ],
  "mark": {
    "type": "point",
    "tooltip": true
  },
  "encoding": {
    "y": {
      "field": "age_group",
      "type": "nominal",
      "title": "Age group",
      "axis": {
        "labelAngle": 0
      }
    },
    "x": {
      "field": "time",
      "type": "quantitative",
      "title": "Time",
      "scale": {
        "domain": [
          10,
          13.5
        ]
      },
      "axis": {
        "values": [
          10,
          10.5,
          11,
          11.5,
          12,
          12.5,
          13,
          13.5
        ],
        "labelExpr": "datum.value === 10 ? '10:00 PM' : datum.value === 10.5 ? '10:30 PM' : datum.value === 11 ? '11:00 PM': datum.value === 11.5 ? '11:30 PM' : datum.value === 12 ? '12:00 AM' : datum.value === 12.5 ? '12:30 AM': datum.value === 13 ? '1:00 AM' : '1:30 AM'",
        "labelAngle": -90
      }
    },
    "xOffset": {
      "field": "night_type"
    },
    "color": {
      "field": "night_type",
      "type": "nominal",
      "title": "Night Type",
      "legend": {
        "labelExpr": "datum.value == 'weekend_nights_onset' ? 'Weekend nights' : datum.value == 'weeknights_onset' ? 'Weeknights' : 'Other'", "orient": "bottom"
      }
    },
    "tooltip": [
      {
        "field": "time",
        "type": "nominal",
        "title": "Time"
      },
      {
        "field": "age_group",
        "type": "nominal",
        "title": "Age Group"
      }
    ]
  }
}