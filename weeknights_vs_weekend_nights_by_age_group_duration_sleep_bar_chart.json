{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": { "text": "Average Duration of Sleep" },
  "data": {
    "url": "weeknights_vs_weekend_nights_by_age_group_average_sleep_onset.csv"
  }, 
  "mark": {
  "type": "bar",
  "clip": true
},
  "encoding": {
    "y": {
      "field": "age_group",
      "type": "nominal",
      "title": "Age Group",
      "axis":{"labelAngle": 0}
    },
    
    "x": { "field": "all_nights_duration", "type": "quantitative", "title": "Hours", "scale": {
       "domain": [7,8]
      },
      "axis": {
        "values": [7,7.5,8],
        "labelExpr": "datum.value === 7 ? '7' : datum.value === 7.5 ? '7.5' : '8'"
    
    }},
    "color": {
      "field": "age_group",
      "type": "nominal",
      "legend":null
      
    }
  }
}